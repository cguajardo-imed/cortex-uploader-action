# Imed Cortex Action - Environment Configuration
# Copy this file to .env and fill in your actual values

# Path to the security scan report file (JSON format)
# Windows example: C:\MyProjects\imed-cortex\scanner\.appdata\scan_results\nrfiber-scan-results.json
# Linux/macOS example: /home/user/projects/scanner/scan-results.json
# WSL example: /mnt/c/MyProjects/imed-cortex/scanner/.appdata/scan_results/nrfiber-scan-results.json
REPORT_PATH=/path/to/your/scan-results.json

# Imed Cortex API endpoint URL
ENDPOINT_URL=https://cortex.example.com/api/...

# API Key for authentication with Imed Cortex
# IMPORTANT: Keep this secret! Never commit the actual .env file to version control
API_KEY=your-api-key-here

# Docker image name (optional - defaults below)
IMAGE_NAME=imed-cortex-action:latest
